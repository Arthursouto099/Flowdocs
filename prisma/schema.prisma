generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activity_log {
  id         String  @id  @default(uuid())
  action     String?
  message    String?
  created_at DateTime? @default(now())
  file_id    String?   
  user_id    String?   
  files      files?    @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model files {
  id           String         @id @default(uuid())
  name         String
  file_url     String
  type         String?        @default("OTHER")
  size         Int?
  uploaded_at  DateTime?      @default(now()) 
  uploaded_by  String?        
  process_id   String?        
  activity_log activity_log[]
  processes    processes?     @relation(fields: [process_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users?         @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model processes {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String?   @default("ATIVO")
  created_at  DateTime? @default(now()) 
  updated_at  DateTime?  @default(now()) 
  created_by  String?  
  collaborators users[] @relation("Collaborators") 
  files       files[]
  user       users?    @relation("Created_by" ,fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id_module String
  module  module @relation(fields: [id_module], references: [id])
    tasks task[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id           String        @id @default(uuid())
  name         String
  email        String         @unique
  role         String?        @default("COLABORADOR")
  created_at   DateTime?      @default(now()) 
  updated_at   DateTime?      @default(now()) 
  password String 
  activity_log activity_log[]
  files        files[]
  processes    processes[] @relation("Created_by")
  collaborators processes[] @relation("Collaborators")
  orgs           Org[]           @relation("Owner")
  collaboratorInOrgs Org[]       @relation("Collaborators_org")
  modules module[] @relation("CreatedByMe")

}

enum TaskStatus {
  CONCLUIDA
  EM_ANDAMENTO
  PENDENTE
}

model task {
  id String @id @default(uuid())
  title String
  description String
  status TaskStatus @default(EM_ANDAMENTO)
  id_process String
  process processes @relation(fields: [id_process], references: [id])
  

}


model module  {
  id String @id @default(uuid())
  name String
  description String
  processes processes[] 
  background_image_url String?
  identifier_code String
  created_by String
  created_at DateTime @default(now())
  user users @relation("CreatedByMe", fields: [created_by], references: [id])
  org Org @relation(fields: [identifier_code], references: [identifier_code])

}

model Org{
  id               String    @id @default(uuid())
  name             String
  identifier_code  String @default(ulid()) @unique
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  created_by       String
  owner            users     @relation("Owner", fields: [created_by], references: [id])
  collaborators_org users[]  @relation("Collaborators_org")
  module module[]
}