generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activity_log {
  id         String  @id  @default(uuid())
  action     String?
  message    String?
  created_at DateTime? @default(now())
  file_id    String?   
  user_id    String?   
  files      files?    @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model files {
  id           String         @id @default(uuid())
  name         String
  file_url     String
  type         String?        @default("OTHER")
  size         Int?
  uploaded_at  DateTime?      @default(now()) 
  uploaded_by  String?        
  process_id   String?        
  activity_log activity_log[]
  processes    processes?     @relation(fields: [process_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users?         @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model processes {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String?   @default("ATIVO")
  created_at  DateTime? @default(now()) 
  updated_at  DateTime?  @default(now()) 
  created_by  String?  
  collaborators users[] @relation("Collaborators") 
  files       files[]
  users       users?    @relation("Created_by" ,fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id           String        @id @default(uuid())
  name         String
  email        String         @unique
  role         String?        @default("COLABORADOR")
  created_at   DateTime?      @default(now()) 
  updated_at   DateTime?      @default(now()) 
  password String 
  activity_log activity_log[]
  files        files[]
  processes    processes[] @relation("Created_by")
  collaborators processes[] @relation("Collaborators")
  
}
