generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activity_log {
  id         String    @id @default(uuid())
  action     String?
  message    String?
  created_at DateTime? @default(now())
  file_id    String?
  user_id    String?
  files      files?    @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model files {
  id           String         @id @default(uuid())
  name         String
  file_url     String
  type         String?        @default("OTHER")
  size         Int?
  uploaded_at  DateTime       @updatedAt
  uploaded_by  String?
  process_id   String?
  activity_log activity_log[]
  processes    processes?     @relation(fields: [process_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users?         @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model processes {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String?  @default("ATIVO")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  String?
  files       files[]
  user        users?   @relation("CreatedBy", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id_module   String
  module      module   @relation(fields: [id_module], references: [id])
  tasks       task[]
}

enum roleUser {
  ADMIN
  EDITOR
  VIEWER
}

model users {
  id                    String         @id @default(uuid())
  name                  String
  email                 String         @unique
  role                  roleUser       @default(VIEWER)
  created_at            DateTime?      @default(now())
  updated_at            DateTime?      @default(now())
  password              String
  activity_log          activity_log[]
  files                 files[]
  processes             processes[]    @relation("CreatedBy")
  orgs                  Org[]          @relation("OwnerOrgs")
  modules               module[]       @relation("CreatedBy")
  collaboratorInModules module[]       @relation("ModuleCollaborators")
  tasks                 task[]         @relation("TaskCreateBy")
  profile_image         String?        @default("")
  orgMemberships OrgUser[]   
}

enum TaskStatus {
  CONCLUIDA
  PENDENTE
}

model task {
  id          String     @id @default(uuid())
  title       String
  description String
  status      TaskStatus @default(PENDENTE)
  id_process  String
  process     processes  @relation(fields: [id_process], references: [id])
  created_by  String
  user        users      @relation("TaskCreateBy", fields: [created_by], references: [id])
}

model module {
  id                   String      @id @default(uuid())
  name                 String
  description          String
  processes            processes[]
  background_image_url String?
  org_id               String
  created_by           String
  created_at           DateTime    @default(now())
  module_collaborators users[]     @relation("ModuleCollaborators")
  user                 users       @relation("CreatedBy", fields: [created_by], references: [id])
  org                  Org         @relation(fields: [org_id], references: [identifier_code])
}

model Org {
  id              String   @id @default(uuid())
  name            String
  identifier_code String   @unique @default(ulid())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  created_by      String
  module          module[]
  owner           users    @relation("OwnerOrgs", fields: [created_by], references: [id])
  members OrgUser[]
}

model OrgUser {
  id        String   @id @default(uuid())
  org_id    String
  user_id  String
  role      roleUser @default(VIEWER)
  joined_at DateTime @default(now())
  org  Org   @relation(fields: [org_id], references: [id])
  user users @relation(fields: [user_id], references: [id])
}
